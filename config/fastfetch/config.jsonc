{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "color": { "1": "yellow" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "yellow",
      "title": "yellow"
    }
  },
  "modules": [
    "break",
    "title",
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "90"
    },
    { "type": "os",       "key": "" },
    { "type": "kernel",   "key": "" },
    { "type": "packages", "key": "󰏖", "format": "{all} (pacman)" },
    { "type": "shell",    "key": "" },
    { "type": "terminal", "key": "" },
    { "type": "wm",       "key": "" },
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "90"
    },
    { "type": "cpu",    "key": "󰻠", "format": "{name}" },
    { "type": "gpu",    "key": "󰢮", "format": "{name}" },
    { "type": "memory", "key": "󰍛" },
    { "type": "disk",   "key": "󰋊", "folders": "/" },
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "90"
    },
    { "type": "uptime", "key": "󰅐" },
    { "type": "media",  "key": "󰝚" },
    "break",
    "colors",
    "break"
  ]
}